# 비밀정보 — 절대 커밋 금지 (평가표 10번)
.env
*.key

# 가상환경
.venv/
venv/
__pycache__/
*.pyc

# 생성물 — 재생성 가능하므로 커밋하지 않음
data/*
!data/.gitkeep
!data/chunks.jsonl
# 실행 로그(.jsonl)는 제외하되, 사람이 쓴 분석 기록(.md)은 남긴다.
# 평가표 5번(실험 기록) 증빙이 쌓여야 한다.
results/runs/*
!results/runs/.gitkeep
!results/runs/*.md
*.faiss
*.index
*.pkl

# 수집 원문 (법령 원문을 받을 경우)
docs/corpus/raw/

# OS
.DS_Store
Thumbs.db

data/index-noprotect/
