# 값은 비우고 이름만 커밋합니다. 실제 키가 든 .env는 .gitignore에 있습니다.
# 모델·검색 설정은 여기가 아니라 configs/*.toml 에서 정합니다 (실행 기록 versions 에 남도록).

# 생성·리라이트 (Claude). langchain-anthropic 이 읽음
ANTHROPIC_API_KEY=
# 생성 깊이: low / medium / high (src/answer/generator.py, 기본 medium)
LLM_EFFORT=medium

# 임베딩 (text-embedding-3-* 를 쓸 때)
OPENAI_API_KEY=
# 색인을 만든 임베딩 모델. 검색 시 색인 메타와 다르면 멈춤 (src/retrieve.py, src/search_adapter.py)
EMBEDDING_MODEL=

# Reranker 를 API 로 쓸 경우에만 (예: Cohere)
# COHERE_API_KEY=
